# Copy to .env and adjust. All values are optional; defaults shown.
AGRISCOPE_MODEL_PATH=models/best.pt   # relative to the project root, or absolute
AGRISCOPE_CONF=0.25                   # default confidence threshold (0.05-0.95)
AGRISCOPE_MAX_UPLOAD_MB=10
AGRISCOPE_MAX_PIXELS=40000000
AGRISCOPE_MAX_DET=100
AGRISCOPE_DEVICE=auto                 # auto | cpu | 0 (first GPU)
# AGRISCOPE_IMGSZ=800                 # override inference size (default: the size stored in the weights)
AGRISCOPE_PRELOAD_MODEL=true
AGRISCOPE_HOST=127.0.0.1
AGRISCOPE_PORT=5000
# AGRISCOPE_DEBUG=true                # development only; never enable in production
